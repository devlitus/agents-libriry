{
  "name": "devagents",
  "version": "0.0.1",
  "description": "A team of AI coding agents — install once, use with MCP, ACP, or CLI",
  "keywords": ["ai", "agents", "coding", "mcp", "acp", "cli", "opencode", "devtools"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devagents/devagents.git"
  },
  "bin": {
    "devagents": "./dist/cli.js",
    "devagents-mcp": "./dist/mcp.js",
    "devagents-acp": "./dist/acp.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@devlitusp/core": "workspace:*",
    "@devlitusp/cli": "workspace:*",
    "@devlitusp/mcp": "workspace:*",
    "@devlitusp/acp": "workspace:*"
  }
}
